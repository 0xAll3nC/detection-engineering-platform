# Copy to `.env` (gitignored) and fill in for live runs. Never commit `.env`.
# `detplat validate --live` loads .env automatically; existing environment
# variables take precedence.

# --- Wazuh indexer (validation telemetry source) ---------------------------
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASS=
# Raw telemetry index. Do not change to wazuh-alerts-* (see ADR-0002).
WAZUH_INDEX_PATTERN=wazuh-archives-*
# TLS verification is on by default. For the lab's self-signed cert, export
# the Wazuh root CA (e.g. from wazuh-docker config/wazuh_indexer_ssl_certs/
# root-ca.pem) and point to it here instead of disabling verification.
WAZUH_INDEXER_CA_BUNDLE=
# WAZUH_INDEXER_VERIFY_TLS=false   # explicit, discouraged opt-out

# --- Windows victim (adversary emulation over WinRM) -----------------------
ATOMIC_VICTIM_HOST=
ATOMIC_VICTIM_USER=
ATOMIC_VICTIM_PASS=
ATOMIC_VICTIM_TRANSPORT=ntlm
